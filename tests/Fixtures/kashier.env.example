# Example environment values for Kashier integration tests.
# Do not put real secrets in source control.
KASHIER_ENVIRONMENT=test
KASHIER_MERCHANT_ID=replace-with-test-merchant-id
KASHIER_PAYMENT_API_KEY=replace-with-test-payment-api-key
KASHIER_SECRET_KEY=replace-with-test-secret-key
KASHIER_SERVER_WEBHOOK_URL=https://example.test/api/payments/kashier/webhook
KASHIER_RETURN_URL=https://example.test/api/payments/kashier/return
