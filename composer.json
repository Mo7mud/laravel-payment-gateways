{
  "name": "mo7mud/laravel-payment-gateway",
  "description": "Multi-gateway payment abstraction for Laravel (Kashier, Fawaterk) with verified webhooks, refund ledger and reconciliation.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-mbstring": "*",
    "illuminate/console": "^11.0|^12.0|^13.0",
    "illuminate/contracts": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "illuminate/http": "^11.0|^12.0|^13.0",
    "illuminate/routing": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/validation": "^11.0|^12.0|^13.0",
    "illuminate/view": "^11.0|^12.0|^13.0",
    "psr/log": "^2.0|^3.0"
  },
  "require-dev": {
    "larastan/larastan": "^2.9|^3.0",
    "laravel/pint": "^1.13",
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^11.5|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Mo7mud\\LaravelPaymentGateway\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mo7mud\\LaravelPaymentGateway\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Mo7mud\\LaravelPaymentGateway\\PaymentServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-text",
    "analyse": "phpstan analyse",
    "format": "pint"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  },
  "keywords": [
    "laravel",
    "payments",
    "kashier",
    "fawaterk",
    "payment-gateway",
    "webhooks",
    "refunds"
  ],
  "authors": [
    {
      "name": "mo7mud"
    }
  ]
}
